#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "usage: normalize-release-version <release-tag>" >&2
	exit 2
fi

version="${1#v}"
version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'

if [[ "${version^^}" == *SNAPSHOT* ]]; then
	echo "release version must not contain SNAPSHOT" >&2
	exit 1
fi

if [[ ! "$version" =~ $version_pattern ]]; then
	echo "release tag must be vMAJOR.MINOR.PATCH or MAJOR.MINOR.PATCH, with optional prerelease/build metadata" >&2
	exit 1
fi

printf '%s\n' "$version"
